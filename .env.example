# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Application
FLASK_ENV=production
FLASK_SECRET_KEY=your-secret-key-here-change-this
DEBUG=False

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-here-change-this
JWT_EXPIRATION_HOURS=24

# Database (for future migration)
# DATABASE_URL=postgresql://user:password@localhost:5432/exam_detection

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Retention
DEFAULT_RETENTION_DAYS=7
MAX_RETENTION_DAYS=30

# CORS (if needed for separate frontend)
# CORS_ORIGINS=https://yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
